# Streamed vesting that pays out in HBAR.
#
# Copy this file to `.env` and fill in the operator credentials. Both `npm run deploy:testnet`
# and the dashboard read that one file; `.env` is git-ignored and must never be committed.
#
# Get testnet credentials from the Hedera portal: create an account, copy the account ID
# and the private key (DER-encoded, hex) it generates, and fund it from the testnet faucet.

# ---------------------------------------------------------------------------
# Operator credentials — required by `npm run deploy:testnet`
# ---------------------------------------------------------------------------

# Account that signs the deployment, in `0.0.<num>` form.
HEDERA_ACCOUNT_ID=

# Private key of the account above, hex encoded and without the `0x` prefix.
# Ed25519 and ECDSA (secp256k1) keys both work, but the constructor differs, so the matching
# HEDERA_ACCOUNT_KEY_TYPE must be set below or the signature fails with an opaque error.
HEDERA_PRIVATE_KEY=

# Which constructor to use for the key above: ED25519 or ECDSA. Most portal keys are
# ED25519. Defaults to ED25519 when unset.
HEDERA_ACCOUNT_KEY_TYPE=ED25519

# ---------------------------------------------------------------------------
# Network — defaults to testnet
# ---------------------------------------------------------------------------

# testnet, previewnet, or mainnet. This selects the Hedera client and the SaucerSwap
# address table, so it must match the network passed to the npm script.
HEDERA_NETWORK=testnet

# ---------------------------------------------------------------------------
# Grant token
# ---------------------------------------------------------------------------

# Token to stream, in `0.0.<num>` form. It must have a SaucerSwap V2 pool against WHBAR at
# the fee tier below, because every claim converts through that router. Leave unset to use
# each network's reference token; Hedera previewnet has no such default, because SaucerSwap
# deploys no V2 contracts there.
HEDERA_GRANT_TOKEN_ID=

# Set to true to create a brand new grant token with the SDK instead of streaming an
# existing one. A token created this way has no SaucerSwap pool, so claims will revert on
# the swap until you seed one. Leave false unless you intend to do that.
HEDERA_CREATE_GRANT_TOKEN=false

# ---------------------------------------------------------------------------
# First stream created by the deploy
# ---------------------------------------------------------------------------

# Account that receives HBAR as tokens vest, in `0.0.<num>` form. Use a second account you
# control, not the operator, so the payout is visibly separate from the funding.
VESTING_BENEFICIARY_ID=

# Total grant, in the token's smallest unit. Defaults to 10,000 tokens at eight decimals.
VESTING_TOTAL_UNITS=1000000000000

# Seconds from deployment until the first unlock. Defaults to one day.
VESTING_CLIFF_SECONDS=86400

# Seconds between unlocks after the cliff. Defaults to one day.
VESTING_RELEASE_INTERVAL_SECONDS=86400

# Number of unlocks, at least one. Defaults to 5.
VESTING_RELEASE_COUNT=5

# SaucerSwap V2 pool fee tier the route is built for: 100, 500, 3000, or 10000.
# 3000 is 0.30%. The pool has to exist at exactly this tier or no swap is possible.
VESTING_POOL_FEE=3000

# Slippage tolerated between the quote and the swap, in basis points. Must be under 10000.
VESTING_MAX_SLIPPAGE_BPS=300

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Network the dashboard reads from the Mirror Node: testnet, previewnet, or mainnet.
# Defaults to testnet.
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Deployed StreamedVesting contract, in `0.0.<num>` form. The deploy script prints this
# line when it finishes. Leave unset and the dashboard explains that nothing is configured
# instead of erroring.
NEXT_PUBLIC_VESTING_CONTRACT_ID=