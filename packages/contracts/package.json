{
  "name": "@scaffold-hbar/streamed-vesting-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Streamed vesting contract that schedules its own HIP-1215 releases and settles every claim in HBAR through the SaucerSwap V2 router.",
  "license": "MIT",
  "author": "Fernando May",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\" && tsc --noEmit",
    "clean": "hardhat clean",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network hedera-testnet",
    "deploy:previewnet": "hardhat run scripts/deploy.ts --network hedera-previewnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network hedera-mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "solhint": "^6.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.89.1"
  }
}
